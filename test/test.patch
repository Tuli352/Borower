+import { Test, TestingModule } from '@nestjs/testing';
+import {
+  BadRequestException,
+  NotFoundException,
+  ConflictException,
+} from '@nestjs/common';
+import { ReferralService } from './referral.service';
+import { PrismaService } from '../prisma/prisma.service';
+import { REFERRAL_POINTS_AWARD, ReferralError } from './referral.constants';
+
+describe('ReferralService', () => {
+  let service: ReferralService;
+  let prisma: {
+    customer: {
+      findUnique: jest.Mock;
+      update: jest.Mock;
+      count: jest.Mock;
+    };
+    $transaction: jest.Mock;
+  };
+
+  beforeEach(async () => {
+    prisma = {
+      customer: {
+        findUnique: jest.fn(),
+        update: jest.fn(),
+        count: jest.fn(),
+      },
+      $transaction: jest.fn((fn) => fn(prisma)),
+    };
+
+    const module: TestingModule = await Test.createTestingModule({
+      providers: [
+        ReferralService,
+        { provide: PrismaService, useValue: prisma },
+      ],
+    }).compile();
+
+    service = module.get(ReferralService);
+  });
+
+  describe('redeem success path', () => {
+    it('links referee and awards 100 points to referrer', async () => {
+      const me = {
+        id: 'c-new',
+        referralCode: 'NEWCODE',
+        referredById: null,
+      };
+      const referrer = {
+        id: 'c-ref',
+        referralCode: 'REFCODE',
+        totalLoyaltyPoints: 10,
+      };
+
+      prisma.customer.findUnique
+        .mockResolvedValueOnce(me) // load me
+        .mockResolvedValueOnce(referrer) // lookup by code
+        .mockResolvedValueOnce(me); // inside transaction re-check
+
+      prisma.customer.update.mockResolvedValue({});
+
+      const result = await service.redeem('c-new', '  REFCODE  ');
+      expect(result).toEqual({
+        referredById: 'c-ref',
+        pointsAwarded: REFERRAL_POINTS_AWARD,
+      });
+      expect(prisma.customer.update).toHaveBeenCalledWith({
+        where: { id: 'c-new' },
+        data: { referredById: 'c-ref' },
+      });
+      expect(prisma.customer.update).toHaveBeenCalledWith({
+        where: { id: 'c-ref' },
+        data: { totalLoyaltyPoints: { increment: 100 } },
+      });
+    });
+
+    it('uses case-sensitive code match (exact code string after trim)', async () => {
+      prisma.customer.findUnique
+        .mockResolvedValueOnce({
+          id: 'c1',
+          referralCode: 'MINE',
+          referredById: null,
+        })
+        .mockResolvedValueOnce({ id: 'r1', referralCode: 'AbC' })
+        .mockResolvedValueOnce({
+          id: 'c1',
+          referralCode: 'MINE',
+          referredById: null,
+        });
+      prisma.customer.update.mockResolvedValue({});
+      await service.redeem('c1', 'AbC');
+      expect(prisma.customer.findUnique).toHaveBeenCalledWith({
+        where: { referralCode: 'AbC' },
+      });
+    });
+  });
+
+  describe('redeem error paths', () => {
+    it('400 invalid_referral_code for empty code', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        referralCode: 'MINE',
+        referredById: null,
+      });
+      await expect(service.redeem('c1', '   ')).rejects.toBeInstanceOf(
+        BadRequestException,
+      );
+      try {
+        await service.redeem('c1', '');
+      } catch (e: any) {
+        expect(e.getResponse()).toEqual(
+          expect.objectContaining({ error: ReferralError.INVALID }),
+        );
+      }
+    });
+
+    it('400 invalid_referral_code for null code', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        referralCode: 'MINE',
+        referredById: null,
+      });
+      await expect(service.redeem('c1', null)).rejects.toBeInstanceOf(
+        BadRequestException,
+      );
+    });
+
+    it('404 when caller customer missing', async () => {
+      prisma.customer.findUnique.mockResolvedValue(null);
+      await expect(service.redeem('missing', 'CODE')).rejects.toBeInstanceOf(
+        NotFoundException,
+      );
+    });
+
+    it('409 when already referred', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        referralCode: 'MINE',
+        referredById: 'already',
+      });
+      await expect(service.redeem('c1', 'OTHER')).rejects.toBeInstanceOf(
+        ConflictException,
+      );
+      try {
+        await service.redeem('c1', 'OTHER');
+      } catch (e: any) {
+        expect(e.getResponse()).toEqual(
+          expect.objectContaining({ error: ReferralError.NOT_ELIGIBLE }),
+        );
+      }
+    });
+
+    it('409 when redeeming own code', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        referralCode: 'OWN',
+        referredById: null,
+      });
+      await expect(service.redeem('c1', 'OWN')).rejects.toBeInstanceOf(
+        ConflictException,
+      );
+    });
+
+    it('404 referral_not_found for unknown code', async () => {
+      prisma.customer.findUnique
+        .mockResolvedValueOnce({
+          id: 'c1',
+          referralCode: 'MINE',
+          referredById: null,
+        })
+        .mockResolvedValueOnce(null);
+      try {
+        await service.redeem('c1', 'NOPE');
+        fail('expected throw');
+      } catch (e: any) {
+        expect(e).toBeInstanceOf(NotFoundException);
+        expect(e.getResponse()).toEqual(
+          expect.objectContaining({ error: ReferralError.NOT_FOUND }),
+        );
+      }
+    });
+
+    it('409 when transaction finds concurrent referral already set', async () => {
+      prisma.customer.findUnique
+        .mockResolvedValueOnce({
+          id: 'c1',
+          referralCode: 'MINE',
+          referredById: null,
+        })
+        .mockResolvedValueOnce({ id: 'r1', referralCode: 'R' })
+        .mockResolvedValueOnce({
+          id: 'c1',
+          referralCode: 'MINE',
+          referredById: 'race-winner',
+        });
+      await expect(service.redeem('c1', 'R')).rejects.toBeInstanceOf(
+        ConflictException,
+      );
+    });
+
+    it('second redeem by same caller always not eligible', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        referralCode: 'MINE',
+        referredById: 'r1',
+      });
+      await expect(service.redeem('c1', 'ANY')).rejects.toBeInstanceOf(
+        ConflictException,
+      );
+    });
+  });
+
+  describe('loadProfileWithReferralSummary', () => {
+    it('returns referralCount and totalLoyaltyPoints', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        name: 'Ada',
+        totalLoyaltyPoints: 250,
+        orders: [],
+        transactions: [],
+        _count: { referrals: 4 },
+      });
+      const profile = await service.loadProfileWithReferralSummary('c1');
+      expect(profile.referralCount).toBe(4);
+      expect(profile.totalLoyaltyPoints).toBe(250);
+      expect(profile.name).toBe('Ada');
+      expect(profile._count).toBeUndefined();
+    });
+
+    it('returns null when customer missing', async () => {
+      prisma.customer.findUnique.mockResolvedValue(null);
+      expect(await service.loadProfileWithReferralSummary('x')).toBeNull();
+    });
+
+    it('defaults referralCount to 0', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        totalLoyaltyPoints: 0,
+        _count: { referrals: 0 },
+      });
+      const profile = await service.loadProfileWithReferralSummary('c1');
+      expect(profile.referralCount).toBe(0);
+    });
+  });
+
+  describe('countReferrals and getReferralStanding', () => {
+    it('countReferrals delegates to prisma count', async () => {
+      prisma.customer.count.mockResolvedValue(7);
+      expect(await service.countReferrals('c-ref')).toBe(7);
+      expect(prisma.customer.count).toHaveBeenCalledWith({
+        where: { referredById: 'c-ref' },
+      });
+    });
+
+    it('getReferralStanding returns summary fields', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        referralCode: 'ABC',
+        referredById: null,
+        totalLoyaltyPoints: 100,
+        _count: { referrals: 2 },
+      });
+      await expect(service.getReferralStanding('c1')).resolves.toEqual({
+        referralCode: 'ABC',
+        referredById: null,
+        referralCount: 2,
+        totalLoyaltyPoints: 100,
+      });
+    });
+
+    it('getReferralStanding 404 when missing', async () => {
+      prisma.customer.findUnique.mockResolvedValue(null);
+      await expect(service.getReferralStanding('x')).rejects.toBeInstanceOf(
+        NotFoundException,
+      );
+    });
+  });
+});
