+describe('referral.utils precheckRedemptionEligibility', () => {
+  it('rejects blank code as INVALID', () => {
+    expect(
+      precheckRedemptionEligibility({
+        code: '',
+        myReferralCode: 'MINE',
+        myReferredById: null,
+      }),
+    ).toBe(ReferralError.INVALID);
+  });
+
+  it('rejects when already referred', () => {
+    expect(
+      precheckRedemptionEligibility({
+        code: 'OTHER',
+        myReferralCode: 'MINE',
+        myReferredById: 'someone',
+      }),
+    ).toBe(ReferralError.NOT_ELIGIBLE);
+  });
+
+  it('rejects own code', () => {
+    expect(
+      precheckRedemptionEligibility({
+        code: 'MINE',
+        myReferralCode: 'MINE',
+        myReferredById: null,
+      }),
+    ).toBe(ReferralError.NOT_ELIGIBLE);
+  });
+
+  it('allows a foreign code when never referred', () => {
+    expect(
+      precheckRedemptionEligibility({
+        code: 'OTHER',
+        myReferralCode: 'MINE',
+        myReferredById: null,
+      }),
+    ).toBeNull();
+  });
+
+  it('allows when myReferralCode is null', () => {
+    expect(
+      precheckRedemptionEligibility({
+        code: 'OTHER',
+        myReferralCode: null,
+        myReferredById: null,
+      }),
+    ).toBeNull();
+  });
+});
