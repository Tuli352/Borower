+      postcheckReferrer({ referrerId: undefined, callerId: 'c1' }),
+    ).toBe(ReferralError.NOT_FOUND);
+  });
+
+  it('NOT_ELIGIBLE when referrer is self', () => {
+    expect(
+      postcheckReferrer({ referrerId: 'c1', callerId: 'c1' }),
