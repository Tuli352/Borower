+/**
+ * Public-contract tests for referral redemption.
+ * Drive CustomersController + profile GET and the RedeemReferralDto.
+ * Do not require a particular internal service layout.
+ */
+import { Test, TestingModule } from '@nestjs/testing';
+import {
+  BadRequestException,
+  NotFoundException,
+  ConflictException,
+} from '@nestjs/common';
+import { validate } from 'class-validator';
+import { CustomersController } from './customers.controller';
+import { CustomersService } from './customers.service';
+import { PrismaService } from '../prisma/prisma.service';
+
+describe('Referral redemption (public behavior)', () => {
+  let controller: CustomersController;
+  let service: CustomersService;
+  let prisma: any;
+
+  const authed = (profileId: string) => ({ user: { profileId } });
+
+  beforeEach(async () => {
+    prisma = {
+      customer: {
+        findUnique: jest.fn(),
+        update: jest.fn().mockResolvedValue({}),
+        count: jest.fn(),
+        findMany: jest.fn(),
+        create: jest.fn(),
+        delete: jest.fn(),
+      },
+      account: { findFirst: jest.fn(), create: jest.fn(), update: jest.fn() },
+      savedLocation: {
+        create: jest.fn(),
+        findMany: jest.fn(),
+        delete: jest.fn(),
+      },
+      transaction: { findMany: jest.fn() },
+      $transaction: jest.fn((fn) => fn(prisma)),
+    };
+
+    const providers: any[] = [
+      CustomersService,
+      { provide: PrismaService, useValue: prisma },
+    ];
+    try {
+      const { ReferralService } = require('./referral.service');
+      providers.push(ReferralService);
+    } catch {
+      /* base: no ReferralService */
+    }
+
+    const module: TestingModule = await Test.createTestingModule({
+      controllers: [CustomersController],
+      providers,
+    }).compile();
+
+    controller = module.get(CustomersController);
+    service = module.get(CustomersService);
+  });
+
+  describe('POST /customers/profile/referral', () => {
+    it('links referee and awards 100 points to referrer', async () => {
+      const me = {
+        id: 'c-new',
+        referralCode: 'NEWCODE',
+        referredById: null,
+      };
+      const referrer = {
+        id: 'c-ref',
+        referralCode: 'REFCODE',
+        totalLoyaltyPoints: 10,
+      };
+      prisma.customer.findUnique
+        .mockResolvedValueOnce(me)
+        .mockResolvedValueOnce(referrer)
+        .mockResolvedValueOnce(me);
+
+      const result = await (controller as any).redeemReferral(
+        authed('c-new'),
+        { code: '  REFCODE  ' },
+      );
+      expect(result).toEqual({
+        referredById: 'c-ref',
+        pointsAwarded: 100,
+      });
+      const updates = prisma.customer.update.mock.calls.map((c: any) => c[0]);
+      expect(updates).toEqual(
+        expect.arrayContaining([
+          expect.objectContaining({
+            where: { id: 'c-new' },
+            data: expect.objectContaining({ referredById: 'c-ref' }),
+          }),
+          expect.objectContaining({
+            where: { id: 'c-ref' },
+            data: expect.objectContaining({
+              totalLoyaltyPoints: { increment: 100 },
+            }),
+          }),
+        ]),
+      );
+    });
+
+    it('uses case-sensitive code match after trim', async () => {
+      prisma.customer.findUnique
+        .mockResolvedValueOnce({
+          id: 'c1',
+          referralCode: 'MINE',
+          referredById: null,
+        })
+        .mockResolvedValueOnce({ id: 'r1', referralCode: 'AbC' })
+        .mockResolvedValueOnce({
+          id: 'c1',
+          referralCode: 'MINE',
+          referredById: null,
+        });
+
+      await (controller as any).redeemReferral(authed('c1'), { code: 'AbC' });
+      const lookups = prisma.customer.findUnique.mock.calls.map(
+        (c: any) => c[0],
+      );
+      expect(lookups).toEqual(
+        expect.arrayContaining([
+          expect.objectContaining({ where: { referralCode: 'AbC' } }),
+        ]),
+      );
+    });
+
+    it('400 invalid_referral_code for empty or whitespace code', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        referralCode: 'MINE',
+        referredById: null,
+      });
+      await expect(
+        (controller as any).redeemReferral(authed('c1'), { code: '   ' }),
+      ).rejects.toBeInstanceOf(BadRequestException);
+      try {
+        await (controller as any).redeemReferral(authed('c1'), { code: '' });
+      } catch (e: any) {
+        const body = e.getResponse?.() ?? e.response ?? e.message;
+        expect(JSON.stringify(body)).toMatch(/invalid_referral_code/);
+      }
+    });
+
+    it('409 when already referred', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        referralCode: 'MINE',
+        referredById: 'already',
+      });
+      await expect(
+        (controller as any).redeemReferral(authed('c1'), { code: 'OTHER' }),
+      ).rejects.toBeInstanceOf(ConflictException);
+      try {
+        await (controller as any).redeemReferral(authed('c1'), {
+          code: 'OTHER',
+        });
+      } catch (e: any) {
+        const body = e.getResponse?.() ?? e.response ?? e.message;
+        expect(JSON.stringify(body)).toMatch(/referral_not_eligible/);
+      }
+    });
+
+    it('409 when redeeming own code', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        referralCode: 'OWN',
+        referredById: null,
+      });
+      await expect(
+        (controller as any).redeemReferral(authed('c1'), { code: 'OWN' }),
+      ).rejects.toBeInstanceOf(ConflictException);
+    });
+
+    it('404 referral_not_found for unknown code', async () => {
+      prisma.customer.findUnique
+        .mockResolvedValueOnce({
+          id: 'c1',
+          referralCode: 'MINE',
+          referredById: null,
+        })
+        .mockResolvedValueOnce(null);
+      try {
+        await (controller as any).redeemReferral(authed('c1'), {
+          code: 'NOPE',
+        });
+        fail('expected throw');
+      } catch (e: any) {
+        expect(e).toBeInstanceOf(NotFoundException);
+        const body = e.getResponse?.() ?? e.response ?? e.message;
+        expect(JSON.stringify(body)).toMatch(/referral_not_found/);
+      }
+    });
+
+    it('409 when transaction re-check finds referredById already set', async () => {
+      prisma.customer.findUnique
+        .mockResolvedValueOnce({
+          id: 'c1',
+          referralCode: 'MINE',
+          referredById: null,
+        })
+        .mockResolvedValueOnce({ id: 'r1', referralCode: 'R' })
+        .mockResolvedValueOnce({
+          id: 'c1',
+          referralCode: 'MINE',
+          referredById: 'race-winner',
+        });
+      await expect(
+        (controller as any).redeemReferral(authed('c1'), { code: 'R' }),
+      ).rejects.toBeInstanceOf(ConflictException);
+    });
+
+    it('second redeem by same caller always not eligible', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        referralCode: 'MINE',
+        referredById: 'r1',
+      });
+      await expect(
+        (controller as any).redeemReferral(authed('c1'), { code: 'ANY' }),
+      ).rejects.toBeInstanceOf(ConflictException);
+    });
+  });
+
+  describe('RedeemReferralDto validation', () => {
+    it('rejects empty code with IsString/IsNotEmpty', async () => {
+      let Dto: any;
+      try {
+        Dto = require('./dto/redeem-referral.dto').RedeemReferralDto;
+      } catch {
+        fail('RedeemReferralDto is required by the public contract');
+        return;
+      }
+      const empty = Object.assign(new Dto(), { code: '' });
+      const missing = Object.assign(new Dto(), {});
+      const ok = Object.assign(new Dto(), { code: 'ABC123' });
+      expect((await validate(empty)).length).toBeGreaterThan(0);
+      expect((await validate(missing)).length).toBeGreaterThan(0);
+      expect(await validate(ok)).toEqual([]);
+    });
+  });
+
+  describe('GET /customers/profile enrichment', () => {
+    it('includes referralCount and totalLoyaltyPoints', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        name: 'Ada',
+        totalLoyaltyPoints: 250,
+        orders: [],
+        transactions: [],
+        _count: { referrals: 4 },
+      });
+      const profile = await controller.getProfile(authed('c1') as any);
+      expect(profile).toHaveProperty('referralCount', 4);
+      expect(profile).toHaveProperty('totalLoyaltyPoints', 250);
+    });
+
+    it('defaults referralCount to 0 when none', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        totalLoyaltyPoints: 0,
+        _count: { referrals: 0 },
+      });
+      const profile = await controller.getProfile(authed('c1') as any);
+      expect(profile).toHaveProperty('referralCount', 0);
+    });
+  });
+});
