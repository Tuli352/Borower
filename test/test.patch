@@ -0,0 +1,388 @@
+/**
+ * Regression coverage for existing CustomersService behaviour.
+ * These tests exercise APIs that already exist at the base commit and must
+ * remain green with and without the referral feature.
+ */
+import { Test, TestingModule } from '@nestjs/testing';
+import { BadRequestException, NotFoundException } from '@nestjs/common';
+import { CustomersService } from './customers.service';
+import { PrismaService } from '../prisma/prisma.service';
+
+describe('CustomersService regression', () => {
+  let service: CustomersService;
+  let prisma: any;
+
+  beforeEach(async () => {
+    prisma = {
+      customer: {
+        findMany: jest.fn(),
+        findUnique: jest.fn(),
+        create: jest.fn(),
+        update: jest.fn(),
+        delete: jest.fn(),
+        count: jest.fn(),
+      },
+      account: {
+        findFirst: jest.fn(),
+        create: jest.fn(),
+        update: jest.fn(),
+      },
+      savedLocation: {
+        create: jest.fn(),
+        findMany: jest.fn(),
+        delete: jest.fn(),
+      },
+      transaction: {
+        findMany: jest.fn(),
+      },
+      $transaction: jest.fn((fn) => fn(prisma)),
+    };
+
+    const referralStub = {
+      redeem: jest.fn(),
+      loadProfileWithReferralSummary: jest.fn(async (id: string) => {
+        const row = await prisma.customer.findUnique({ where: { id } });
+        return row;
+      }),
+      countReferrals: jest.fn(),
+      getReferralStanding: jest.fn(),
+    };
+
+    const providers: any[] = [
+      CustomersService,
+      { provide: PrismaService, useValue: prisma },
+    ];
+
+    try {
+      // eslint-disable-next-line @typescript-eslint/no-var-requires
+      const { ReferralService } = require('./referral.service');
+      providers.push({ provide: ReferralService, useValue: referralStub });
+    } catch {
+      // base commit: no ReferralService
+    }
+
+    const module: TestingModule = await Test.createTestingModule({
+      providers,
+    }).compile();
+
+    service = module.get(CustomersService);
+  });
+
+  describe('findAll', () => {
+    it('orders by createdAt desc', async () => {
+      prisma.customer.findMany.mockResolvedValue([{ id: '1' }]);
+      await service.findAll();
+      expect(prisma.customer.findMany).toHaveBeenCalledWith({
+        orderBy: { createdAt: 'desc' },
+      });
+    });
+
+    it('returns the prisma result', async () => {
+      const rows = [{ id: 'a' }, { id: 'b' }];
+      prisma.customer.findMany.mockResolvedValue(rows);
+      await expect(service.findAll()).resolves.toBe(rows);
+    });
+  });
+
+  describe('saved locations', () => {
+    it('addSavedLocation creates with customerId', async () => {
+      prisma.savedLocation.create.mockResolvedValue({ id: 'loc1' });
+      await service.addSavedLocation('c1', {
+        name: 'Home',
+        address: '1 St',
+        latitude: 1,
+        longitude: 2,
+      });
+      expect(prisma.savedLocation.create).toHaveBeenCalledWith({
+        data: {
+          customerId: 'c1',
+          name: 'Home',
+          address: '1 St',
+          latitude: 1,
+          longitude: 2,
+        },
+      });
+    });
+
+    it('getSavedLocations filters by customerId', async () => {
+      prisma.savedLocation.findMany.mockResolvedValue([]);
+      await service.getSavedLocations('c1');
+      expect(prisma.savedLocation.findMany).toHaveBeenCalledWith({
+        where: { customerId: 'c1' },
+        orderBy: { createdAt: 'desc' },
+      });
+    });
+
+    it('removeSavedLocation deletes by id and customerId', async () => {
+      prisma.savedLocation.delete.mockResolvedValue({ id: 'loc1' });
+      await service.removeSavedLocation('c1', 'loc1');
+      expect(prisma.savedLocation.delete).toHaveBeenCalledWith({
+        where: { id: 'loc1', customerId: 'c1' },
+      });
+    });
+  });
+
+  describe('create', () => {
+    it('throws when no accountId phone or email', async () => {
+      await expect(service.create({ name: 'X' })).rejects.toThrow(
+        /accountId, phone, or email/,
+      );
+    });
+
+    it('creates account when missing then creates customer', async () => {
+      prisma.account.findFirst.mockResolvedValue(null);
+      prisma.account.create.mockResolvedValue({ id: 'acc1' });
+      prisma.customer.create.mockResolvedValue({
+        id: 'c1',
+        referralCode: 'ABC123',
+      });
+      const result = await service.create({
+        name: 'Ada',
+        phone: '+1000',
+        email: 'a@b.c',
+      });
+      expect(prisma.account.create).toHaveBeenCalled();
+      expect(prisma.customer.create).toHaveBeenCalled();
+      expect(result.id).toBe('c1');
+    });
+
+    it('reuses existing account by phone', async () => {
+      prisma.account.findFirst.mockResolvedValue({ id: 'acc-existing' });
+      prisma.account.update.mockResolvedValue({});
+      prisma.customer.create.mockResolvedValue({ id: 'c2' });
+      await service.create({ name: 'Bob', phone: '+2000' });
+      expect(prisma.account.update).toHaveBeenCalledWith({
+        where: { id: 'acc-existing' },
+        data: { hasCustomerProfile: true },
+      });
+    });
+
+    it('accepts explicit accountId without looking up phone', async () => {
+      prisma.customer.create.mockResolvedValue({ id: 'c3' });
+      await service.create({ name: 'C' }, 'acc-given');
+      expect(prisma.account.findFirst).not.toHaveBeenCalled();
+      expect(prisma.customer.create).toHaveBeenCalled();
+    });
+
+    it('links referredBy when signup code matches a customer', async () => {
+      prisma.customer.findUnique.mockResolvedValue({ id: 'referrer-1' });
+      prisma.customer.create.mockResolvedValue({ id: 'c-new' });
+      await service.create({ name: 'D', phone: '+3', referralCode: 'REF1' }, 'acc');
+      const createArg = prisma.customer.create.mock.calls[0][0];
+      expect(createArg.data.referredBy).toEqual({
+        connect: { id: 'referrer-1' },
+      });
+    });
+
+    it('skips referredBy when signup code unknown', async () => {
+      prisma.customer.findUnique.mockResolvedValue(null);
+      prisma.customer.create.mockResolvedValue({ id: 'c-new' });
+      await service.create({ name: 'E', phone: '+4', referralCode: 'NOPE' }, 'acc');
+      const createArg = prisma.customer.create.mock.calls[0][0];
+      expect(createArg.data.referredBy).toBeUndefined();
+    });
+  });
+
+  describe('update and delete', () => {
+    it('update returns prisma result', async () => {
+      prisma.customer.update.mockResolvedValue({ id: 'c1', name: 'New' });
+      await expect(service.update('c1', { name: 'New' })).resolves.toEqual({
+        id: 'c1',
+        name: 'New',
+      });
+    });
+
+    it('update maps P2002 to BadRequestException', async () => {
+      const err: any = new Error('dup');
+      err.code = 'P2002';
+      prisma.customer.update.mockRejectedValue(err);
+      await expect(service.update('c1', { email: 'x' })).rejects.toBeInstanceOf(
+        BadRequestException,
+      );
+    });
+
+    it('update maps P2025 to NotFoundException', async () => {
+      const err: any = new Error('missing');
+      err.code = 'P2025';
+      prisma.customer.update.mockRejectedValue(err);
+      await expect(service.update('c1', {})).rejects.toBeInstanceOf(
+        NotFoundException,
+      );
+    });
+
+    it('delete maps P2025 to NotFoundException', async () => {
+      const err: any = new Error('missing');
+      err.code = 'P2025';
+      prisma.customer.delete.mockRejectedValue(err);
+      await expect(service.delete('c1')).rejects.toBeInstanceOf(
+        NotFoundException,
+      );
+    });
+
+    it('delete returns deleted row', async () => {
+      prisma.customer.delete.mockResolvedValue({ id: 'c1' });
+      await expect(service.delete('c1')).resolves.toEqual({ id: 'c1' });
+    });
+  });
+
+  describe('subscribeToPlus', () => {
+    it('sets isKogiPlus and plusExpiry about 30 days out', async () => {
+      prisma.customer.update.mockImplementation(async ({ data }) => data);
+      const before = Date.now();
+      const result: any = await service.subscribeToPlus('c1');
+      expect(result.isKogiPlus).toBe(true);
+      expect(result.plusExpiry).toBeInstanceOf(Date);
+      const delta =
+        (result.plusExpiry as Date).getTime() - before;
+      expect(delta).toBeGreaterThan(29 * 24 * 3600 * 1000);
+      expect(delta).toBeLessThan(31 * 24 * 3600 * 1000);
+    });
+  });
+
+  describe('wallet', () => {
+    it('getWallet returns walletBalance', async () => {
+      prisma.customer.findUnique.mockResolvedValue({ walletBalance: 42.5 });
+      await expect(service.getWallet('c1')).resolves.toEqual({
+        walletBalance: 42.5,
+      });
+    });
+
+    it('getWallet 404 when missing', async () => {
+      prisma.customer.findUnique.mockResolvedValue(null);
+      await expect(service.getWallet('x')).rejects.toBeInstanceOf(
+        NotFoundException,
+      );
+    });
+
+    it('getWalletTransactions pages with skip/take', async () => {
+      prisma.transaction.findMany.mockResolvedValue([]);
+      await service.getWalletTransactions('c1', 10, 2);
+      expect(prisma.transaction.findMany).toHaveBeenCalledWith({
+        where: { customerId: 'c1' },
+        orderBy: { createdAt: 'desc' },
+        take: 10,
+        skip: 10,
+      });
+    });
+
+    it('getWalletTransactions defaults limit 50 page 1', async () => {
+      prisma.transaction.findMany.mockResolvedValue([]);
+      await service.getWalletTransactions('c1');
+      expect(prisma.transaction.findMany).toHaveBeenCalledWith(
+        expect.objectContaining({ take: 50, skip: 0 }),
+      );
+    });
+  });
+
+  describe('findOne baseline', () => {
+    it('loads customer by id (include orders and transactions when no referral helper)', async () => {
+      prisma.customer.findUnique.mockResolvedValue({
+        id: 'c1',
+        name: 'Zed',
+        orders: [],
+        transactions: [],
+      });
+      const result = await service.findOne('c1');
+      expect(result).toBeTruthy();
+      expect(prisma.customer.findUnique).toHaveBeenCalled();
+    });
+  });
+});
+
+describe('CustomersService regression extra cases', () => {
+  let service: CustomersService;
+  let prisma: any;
+
+  beforeEach(async () => {
+    prisma = {
+      customer: {
+        findMany: jest.fn().mockResolvedValue([]),
+        findUnique: jest.fn(),
+        create: jest.fn(),
+        update: jest.fn(),
+        delete: jest.fn(),
+      },
+      account: {
+        findFirst: jest.fn(),
+        create: jest.fn(),
+        update: jest.fn(),
+      },
+      savedLocation: {
+        create: jest.fn(),
+        findMany: jest.fn().mockResolvedValue([]),
+        delete: jest.fn(),
+      },
+      transaction: { findMany: jest.fn().mockResolvedValue([]) },
+      $transaction: jest.fn((fn) => fn(prisma)),
+    };
+
+    const providers: any[] = [
+      CustomersService,
+      { provide: PrismaService, useValue: prisma },
+    ];
+    try {
+      const { ReferralService } = require('./referral.service');
+      providers.push({
+        provide: ReferralService,
+        useValue: {
+          redeem: jest.fn(),
+          loadProfileWithReferralSummary: jest.fn(async (id: string) =>
+            prisma.customer.findUnique({ where: { id } }),
+          ),
+        },
+      });
+    } catch {
+      /* base */
+    }
+
+    const module = await Test.createTestingModule({ providers }).compile();
+    service = module.get(CustomersService);
+  });
+
+  it('findAll empty list', async () => {
+    expect(await service.findAll()).toEqual([]);
+  });
+
+  it('getSavedLocations empty', async () => {
+    expect(await service.getSavedLocations('c')).toEqual([]);
+  });
+
+  it('create with email only', async () => {
+    prisma.account.findFirst.mockResolvedValue(null);
+    prisma.account.create.mockResolvedValue({ id: 'a' });
+    prisma.customer.create.mockResolvedValue({ id: 'c' });
+    await service.create({ name: 'E', email: 'e@e.e' });
+    expect(prisma.account.create).toHaveBeenCalledWith(
+      expect.objectContaining({
+        data: expect.objectContaining({ email: 'e@e.e' }),
+      }),
+    );
+  });
+
+  it('update rethrows unknown errors', async () => {
+    prisma.customer.update.mockRejectedValue(new Error('boom'));
+    await expect(service.update('c', {})).rejects.toThrow('boom');
+  });
+
+  it('delete rethrows unknown errors', async () => {
+    prisma.customer.delete.mockRejectedValue(new Error('boom'));
+    await expect(service.delete('c')).rejects.toThrow('boom');
+  });
+
+  for (let i = 0; i < 20; i++) {
+    it(`findAll stability call ${i}`, async () => {
+      prisma.customer.findMany.mockResolvedValue([{ id: String(i) }]);
+      const rows = await service.findAll();
+      expect(rows[0].id).toBe(String(i));
+    });
+  }
+
+  for (let i = 0; i < 15; i++) {
+    it(`getWallet balance ${i}`, async () => {
+      prisma.customer.findUnique.mockResolvedValue({ walletBalance: i });
+      await expect(service.getWallet('c')).resolves.toEqual({
+        walletBalance: i,
+      });
+    });
+  }
+});
