index 0000000..819c8da
--- /dev/null
+++ b/src/customers/referral.constants.ts
@@ -0,0 +1,28 @@
+/**
+ * Fixed loyalty-point bonus granted to the referrer when a code is redeemed.
+ * Product can change this single value without touching service logic.
+ */
+export const REFERRAL_POINTS_AWARD = 100;
+
+/**
+ * Stable error codes returned in JSON bodies for referral redemption failures.
+ * Clients should match on these strings rather than HTTP status alone.
+ */
+export const ReferralError = {
+  /** Empty or whitespace-only code after trim */
+  INVALID: 'invalid_referral_code',
+  /** No customer owns the supplied code */
+  NOT_FOUND: 'referral_not_found',
+  /** Own code, already referred, or other business rule block */
+  NOT_ELIGIBLE: 'referral_not_eligible',
+} as const;
+
+export type ReferralErrorCode =
+  (typeof ReferralError)[keyof typeof ReferralError];
+
+/** HTTP status mapping used by the service when throwing Nest exceptions */
+export const ReferralHttpStatus: Record<ReferralErrorCode, number> = {
+  invalid_referral_code: 400,
+  referral_not_found: 404,
+  referral_not_eligible: 409,
+};
diff --git a/src/customers/referral.service.ts b/src/customers/referral.service.ts
new file mode 100644
index 0000000..12fa7fe
--- /dev/null
+++ b/src/customers/referral.service.ts
@@ -0,0 +1,156 @@
+import {
+  Injectable,
+  BadRequestException,
+  NotFoundException,
+  ConflictException,
+} from '@nestjs/common';
+import { PrismaService } from '../prisma/prisma.service';
+import {
+  REFERRAL_POINTS_AWARD,
+  ReferralError,
+} from './referral.constants';
+import {
+  normalizeReferralCode,
+  precheckRedemptionEligibility,
+  postcheckReferrer,
+  buildRedeemSuccess,
+  attachReferralSummary,
+} from './referral.utils';
+
+/**
+ * Owns referral redemption and profile summary enrichment.
+ * Kept separate from the general CustomersService so the redemption
+ * transaction and eligibility rules stay in one place.
+ */
+@Injectable()
+export class ReferralService {
+  constructor(private readonly prisma: PrismaService) {}
+
+  /**
+   * Redeem `rawCode` for `customerId`. Awards REFERRAL_POINTS_AWARD to the
+   * referrer. Concurrent attempts for the same referee cannot double-award.
+   */
+  async redeem(
+    customerId: string,
+    rawCode: string | undefined | null,
+  ): Promise<{ referredById: string; pointsAwarded: number }> {
+    const code = normalizeReferralCode(rawCode);
+
+    const me = await this.prisma.customer.findUnique({
+      where: { id: customerId },
+    });
+    if (!me) {
+      throw new NotFoundException('Customer not found');
+    }
+
+    const early = precheckRedemptionEligibility({
+      code,
+      myReferralCode: me.referralCode,
+      myReferredById: me.referredById,
+    });
+    if (early === ReferralError.INVALID) {
+      throw new BadRequestException({ error: ReferralError.INVALID });
+    }
+    if (early === ReferralError.NOT_ELIGIBLE) {
+      throw new ConflictException({ error: ReferralError.NOT_ELIGIBLE });
+    }
+
+    const referrer = await this.prisma.customer.findUnique({
+      where: { referralCode: code },
+    });
+
+    const post = postcheckReferrer({
+      referrerId: referrer?.id,
+      callerId: customerId,
+    });
+    if (post === ReferralError.NOT_FOUND) {
+      throw new NotFoundException({ error: ReferralError.NOT_FOUND });
+    }
+    if (post === ReferralError.NOT_ELIGIBLE) {
+      throw new ConflictException({ error: ReferralError.NOT_ELIGIBLE });
+    }
+
+    const referrerId = referrer!.id;
+    const points = REFERRAL_POINTS_AWARD;
+
+    await this.prisma.$transaction(async (tx) => {
+      const current = await tx.customer.findUnique({
+        where: { id: customerId },
+      });
+      if (!current || current.referredById) {
+        throw new ConflictException({ error: ReferralError.NOT_ELIGIBLE });
+      }
+
+      await tx.customer.update({
+        where: { id: customerId },
+        data: { referredById: referrerId },
+      });
+
+      await tx.customer.update({
+        where: { id: referrerId },
+        data: { totalLoyaltyPoints: { increment: points } },
+      });
+    });
+
+    return buildRedeemSuccess(referrerId, points);
+  }
+
+  /**
+   * Load a customer and attach referralCount + totalLoyaltyPoints for the
+   * authenticated profile response.
+   */
+  async loadProfileWithReferralSummary(id: string) {
+    const customer = await this.prisma.customer.findUnique({
+      where: { id },
+      include: {
+        orders: { orderBy: { createdAt: 'desc' } },
+        transactions: { orderBy: { createdAt: 'desc' } },
+        _count: { select: { referrals: true } },
+      },
+    });
+    if (!customer) {
+      return null;
+    }
+    const { _count, ...rest } = customer as any;
+    return attachReferralSummary(rest, _count?.referrals ?? 0);
+  }
+
+  /**
+   * Count how many customers list `customerId` as their referrer.
+   * Used by admin tooling and tests; profile path uses _count include.
+   */
+  async countReferrals(customerId: string): Promise<number> {
+    return this.prisma.customer.count({
+      where: { referredById: customerId },
+    });
+  }
+
+  /**
+   * Read-only view of a customer's referral standing without full profile includes.
+   */
+  async getReferralStanding(customerId: string): Promise<{
+    referralCode: string | null;
+    referredById: string | null;
+    referralCount: number;
+    totalLoyaltyPoints: number;
+  }> {
+    const row = await this.prisma.customer.findUnique({
+      where: { id: customerId },
+      select: {
+        referralCode: true,
+        referredById: true,
+        totalLoyaltyPoints: true,
+        _count: { select: { referrals: true } },
+      },
+    });
+    if (!row) {
+      throw new NotFoundException('Customer not found');
+    }
+    return {
+      referralCode: row.referralCode,
+      referredById: row.referredById,
+      referralCount: row._count.referrals,
+      totalLoyaltyPoints: row.totalLoyaltyPoints ?? 0,
+    };
+  }
+}
diff --git a/src/customers/referral.utils.ts b/src/customers/referral.utils.ts
new file mode 100644
index 0000000..3f4a335
--- /dev/null
+++ b/src/customers/referral.utils.ts
@@ -0,0 +1,214 @@
+import { ReferralError, ReferralErrorCode } from './referral.constants';
+
+/**
+ * Normalize a raw referral code from the request body.
+ * Trims leading/trailing whitespace; does not change case.
+ */
+export function normalizeReferralCode(
+  raw: string | undefined | null,
+): string {
+  if (typeof raw !== 'string') {
+    return '';
+  }
+  return raw.trim();
+}
+
+/**
+ * Decide whether a non-empty code is usable for redemption against `me`.
+ * Returns an error code when the attempt must be rejected before any DB write
+ * that awards points; returns null when the attempt may proceed to lookup.
+ */
+export function precheckRedemptionEligibility(args: {
+  code: string;
+  myReferralCode: string | null | undefined;
+  myReferredById: string | null | undefined;
+}): ReferralErrorCode | null {
+  const { code, myReferralCode, myReferredById } = args;
+  if (!code) {
+    return ReferralError.INVALID;
+  }
+  if (myReferredById) {
+    return ReferralError.NOT_ELIGIBLE;
+  }
+  if (myReferralCode && myReferralCode === code) {
+    return ReferralError.NOT_ELIGIBLE;
+  }
+  return null;
+}
+
+/**
+ * After the referrer row is loaded, confirm the caller is allowed to claim it.
+ */
+export function postcheckReferrer(args: {
+  referrerId: string | undefined | null;
+  callerId: string;
+}): ReferralErrorCode | null {
+  if (!args.referrerId) {
+    return ReferralError.NOT_FOUND;
+  }
+  if (args.referrerId === args.callerId) {
+    return ReferralError.NOT_ELIGIBLE;
+  }
+  return null;
+}
+
+/**
+ * Build the success payload returned to the client after a successful redeem.
+ */
+export function buildRedeemSuccess(
+  referredById: string,
+  pointsAwarded: number,
+): { referredById: string; pointsAwarded: number } {
+  return { referredById, pointsAwarded };
+}
+
+/**
+ * Shape used when enriching a customer profile for the authenticated me surface.
+ */
+export function attachReferralSummary<T extends Record<string, unknown>>(
+  customer: T,
+  referralCount: number,
+): T & { referralCount: number; totalLoyaltyPoints: number } {
+  const points =
+    typeof (customer as any).totalLoyaltyPoints === 'number'
+      ? (customer as any).totalLoyaltyPoints
+      : 0;
+  return {
+    ...customer,
+    referralCount,
+    totalLoyaltyPoints: points,
+  };
+}
+
+/**
+ * Guard helpers for unit tests and defensive coding — pure predicates.
+ */
+export function isBlankCode(code: string): boolean {
+  return code.length === 0;
+}
+
+export function isSelfReferral(
+  code: string,
+  myCode: string | null | undefined,
+): boolean {
+  return !!myCode && myCode === code;
+}
+
+export function alreadyReferred(
+  referredById: string | null | undefined,
+): boolean {
+  return !!referredById;
+}
+
+/**
+ * Sequence of checks used by the service layer. Extracted so tests can
+ * assert the same decision table the API relies on without spinning Nest.
+ */
+export function evaluateRedemptionAttempt(input: {
+  rawCode: string | undefined | null;
+  myReferralCode: string | null | undefined;
+  myReferredById: string | null | undefined;
+  referrerId: string | null | undefined;
+  callerId: string;
+}): { ok: true } | { ok: false; error: ReferralErrorCode } {
+  const code = normalizeReferralCode(input.rawCode);
+  const pre = precheckRedemptionEligibility({
+    code,
+    myReferralCode: input.myReferralCode,
+    myReferredById: input.myReferredById,
+  });
+  if (pre) {
+    return { ok: false, error: pre };
+  }
+  const post = postcheckReferrer({
+    referrerId: input.referrerId,
+    callerId: input.callerId,
+  });
+  if (post) {
+    return { ok: false, error: post };
+  }
+  return { ok: true };
+}
+
+/**
+ * Validate that a points award is the configured constant (defensive).
+ */
+export function assertAwardAmount(points: number, expected: number): void {
+  if (points !== expected) {
+    throw new Error(
+      `Unexpected referral award ${points}; expected ${expected}`,
+    );
+  }
+}
+
+/**
+ * Produce a stable snapshot of eligibility inputs for logging/audit.
+ * Does not include PII beyond ids and codes already known to the system.
+ */
+export function eligibilitySnapshot(input: {
+  callerId: string;
+  code: string;
+  myReferralCode: string | null | undefined;
+  myReferredById: string | null | undefined;
+  referrerId: string | null | undefined;
+}): Record<string, string | boolean | null> {
+  return {
+    callerId: input.callerId,
+    code: input.code,
+    myReferralCode: input.myReferralCode ?? null,
+    alreadyReferred: alreadyReferred(input.myReferredById),
+    isSelfCode: isSelfReferral(input.code, input.myReferralCode),
+    referrerId: input.referrerId ?? null,
+  };
+}
+
+/**
+ * Merge multiple referrer lookup strategies (exact code only today).
+ * Reserved for future case-insensitive or alias lookups without changing
+ * the redeem transaction.
+ */
+export function pickReferrerId(
+  candidates: Array<{ id: string } | null | undefined>,
+): string | null {
+  for (const c of candidates) {
+    if (c && c.id) {
+      return c.id;
+    }
+  }
+  return null;
+}
+
+/**
+ * Ensure the response body never leaks internal fields.
+ */
+export function sanitizeRedeemResponse(body: {
+  referredById: string;
+  pointsAwarded: number;
+  [key: string]: unknown;
+}): { referredById: string; pointsAwarded: number } {
+  return {
+    referredById: String(body.referredById),
+    pointsAwarded: Number(body.pointsAwarded),
+  };
+}
+
+/**
+ * Profile field defaults when the customer row is sparse.
+ */
+export function defaultProfileExtras(referralCount = 0, points = 0) {
+  return {
+    referralCount: Math.max(0, referralCount | 0),
+    totalLoyaltyPoints: typeof points === 'number' ? points : 0,
+  };
+}
+
+/**
+ * True when the HTTP client sent a body that is missing the code key entirely
+ * versus sending an explicit empty string (both map to invalid after normalize).
+ */
+export function missingCodeKey(body: unknown): boolean {
+  if (body == null || typeof body !== 'object') {
+    return true;
+  }
+  return !Object.prototype.hasOwnProperty.call(body, 'code');
+}
